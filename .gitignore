# Sistema
.DS_Store
Thumbs.db
desktop.ini

# Imágenes de Docker: van como asset de Release, no en el árbol
*.tar
*.tar.gz

# Estado de los contenedores al correr el laboratorio.
# Los .gitkeep si van: docker monta estos directorios como bind mount y
# cowrie no crea los que le faltan — sin ellos el arranque falla en limpio.
mi-lab/cowrie/log/*
!mi-lab/cowrie/log/.gitkeep
mi-lab/cowrie/etc/*
!mi-lab/cowrie/etc/.gitkeep
!mi-lab/cowrie/etc/cowrie.cfg

# Python
__pycache__/
*.pyc

# Trabajo local de los alumnos
*.local.json
export-*.md

# ════════════════════════════════════════════════════════════════════════
# MATERIAL DE INSTRUCTOR — no se publica.
# Vive dentro del repo para que las rutas relativas de la guía funcionen
# (../labs/, ../assets/), pero git no lo ve. Hay un hook de pre-commit que
# aborta el commit si algo de acá llega al índice.
# ════════════════════════════════════════════════════════════════════════
instructor/
