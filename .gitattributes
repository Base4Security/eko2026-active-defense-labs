# Git for Windows checkoutea con CRLF por defecto (core.autocrlf=true). Varios
# de estos archivos viajan adentro de los contenedores —configs que parsea
# Samba, Cowrie y OpenCanary, y el app.py del portal—, así que acá se fuerza LF
# sin importar la plataforma del alumno.

* text=auto eol=lf

*.py        text eol=lf
*.cfg       text eol=lf
*.conf      text eol=lf
*.json      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.sh        text eol=lf
*.css       text eol=lf
*.js        text eol=lf
*.html      text eol=lf
*.txt       text eol=lf
*.md        text eol=lf
Dockerfile  text eol=lf

# Binarios: que git no los toque.
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.pdf       binary
*.docx      binary
*.xlsx      binary
*.pptx      binary
*.zip       binary
*.tar       binary
